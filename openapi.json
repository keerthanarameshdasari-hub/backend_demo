{
  "components": {
    "schemas": {
      "AdminKycSubmissionPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminKycSubmissionResponse"
            },
            "type": "array"
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "total": {
            "description": "Rows matching the filter, across all pages",
            "type": "number"
          }
        },
        "required": [
          "total",
          "limit",
          "offset",
          "items"
        ],
        "type": "object"
      },
      "AdminKycSubmissionResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "decidedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "decisionReason": {
            "nullable": true,
            "type": "string"
          },
          "documentMimeType": {
            "example": "image/png",
            "type": "string"
          },
          "documentNumberLast4": {
            "example": "4567",
            "type": "string"
          },
          "documentType": {
            "enum": [
              "PASSPORT",
              "NATIONAL_ID",
              "DRIVING_LICENCE"
            ],
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "reviewedBy": {
            "description": "The admin who overrode the provider decision; null when the provider decided",
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "PENDING",
              "APPROVED",
              "REJECTED",
              "TIMED_OUT"
            ],
            "type": "string"
          },
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OwnerResponse"
              }
            ],
            "nullable": true,
            "type": "object"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "documentType",
          "documentNumberLast4",
          "status",
          "createdAt",
          "userId",
          "documentMimeType"
        ],
        "type": "object"
      },
      "AdminTopUpPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminTopUpResponse"
            },
            "type": "array"
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "total": {
            "description": "Rows matching the filter, across all pages",
            "type": "number"
          }
        },
        "required": [
          "total",
          "limit",
          "offset",
          "items"
        ],
        "type": "object"
      },
      "AdminTopUpResponse": {
        "properties": {
          "amountMinor": {
            "type": "number"
          },
          "completedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "failureReason": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "SUCCEEDED",
              "FAILED",
              "TIMED_OUT"
            ],
            "type": "string"
          },
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OwnerResponse"
              }
            ],
            "nullable": true,
            "type": "object"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "amountMinor",
          "currency",
          "status",
          "createdAt",
          "userId"
        ],
        "type": "object"
      },
      "AdminUserPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            },
            "type": "array"
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "total": {
            "description": "Rows matching the filter, across all pages",
            "type": "number"
          }
        },
        "required": [
          "total",
          "limit",
          "offset",
          "items"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "example": "VALIDATION",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "statusCode": {
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "KycSubmissionForm": {
        "properties": {
          "document": {
            "description": "JPEG, PNG or PDF",
            "format": "binary",
            "type": "string"
          },
          "documentNumber": {
            "description": "With the mock provider, a number starting REJECT is rejected and TIMEOUT never answers.",
            "example": "P1234567",
            "type": "string"
          },
          "documentType": {
            "enum": [
              "PASSPORT",
              "NATIONAL_ID",
              "DRIVING_LICENCE"
            ],
            "type": "string"
          }
        },
        "required": [
          "documentType",
          "documentNumber",
          "document"
        ],
        "type": "object"
      },
      "KycSubmissionResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "decidedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "decisionReason": {
            "nullable": true,
            "type": "string"
          },
          "documentNumberLast4": {
            "example": "4567",
            "type": "string"
          },
          "documentType": {
            "enum": [
              "PASSPORT",
              "NATIONAL_ID",
              "DRIVING_LICENCE"
            ],
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "PENDING",
              "APPROVED",
              "REJECTED",
              "TIMED_OUT"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "documentType",
          "documentNumberLast4",
          "status",
          "createdAt"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "example": "asha@example.com",
            "type": "string"
          },
          "password": {
            "example": "correct-horse-battery",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "MinAppVersionResponse": {
        "properties": {
          "minAppVersion": {
            "description": "Oldest mobile app version the API still supports (semver)",
            "example": "1.0.0",
            "type": "string"
          }
        },
        "required": [
          "minAppVersion"
        ],
        "type": "object"
      },
      "OwnerResponse": {
        "properties": {
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "fullName"
        ],
        "type": "object"
      },
      "ReadinessCheckResult": {
        "properties": {
          "name": {
            "example": "database",
            "type": "string"
          },
          "status": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheckResult"
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "example": "asha@example.com",
            "type": "string"
          },
          "fullName": {
            "example": "Asha Rao",
            "type": "string"
          },
          "password": {
            "example": "correct-horse-battery",
            "minLength": 10,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ],
        "type": "object"
      },
      "RejectKycRequest": {
        "properties": {
          "reason": {
            "description": "Shown to the user as the decision reason",
            "example": "Document photo is unreadable",
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "description": "Lifetime in seconds",
            "type": "number"
          },
          "tokenType": {
            "enum": [
              "Bearer"
            ],
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "type": "object"
      },
      "TopUpRequest": {
        "properties": {
          "amountMinor": {
            "description": "Amount in minor units (paise for INR)",
            "example": 50000,
            "type": "number"
          },
          "paymentToken": {
            "description": "Token from the payment SDK. With the mock provider, tok_reject… is declined and tok_timeout… never answers.",
            "example": "tok_visa",
            "type": "string"
          }
        },
        "required": [
          "amountMinor",
          "paymentToken"
        ],
        "type": "object"
      },
      "TopUpResponse": {
        "properties": {
          "amountMinor": {
            "type": "number"
          },
          "completedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "failureReason": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "SUCCEEDED",
              "FAILED",
              "TIMED_OUT"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "amountMinor",
          "currency",
          "status",
          "createdAt"
        ],
        "type": "object"
      },
      "TopUpResultResponse": {
        "properties": {
          "topUp": {
            "$ref": "#/components/schemas/TopUpResponse"
          },
          "wallet": {
            "$ref": "#/components/schemas/WalletResponse"
          }
        },
        "required": [
          "topUp",
          "wallet"
        ],
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kycStatus": {
            "enum": [
              "NOT_STARTED",
              "PENDING",
              "APPROVED",
              "REJECTED",
              "TIMED_OUT"
            ],
            "type": "string"
          },
          "role": {
            "description": "ADMIN can use the /admin endpoints",
            "enum": [
              "USER",
              "ADMIN"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "role",
          "kycStatus",
          "createdAt"
        ],
        "type": "object"
      },
      "WalletResponse": {
        "properties": {
          "balanceMinor": {
            "description": "Balance in minor units (paise for INR)",
            "example": 50000,
            "type": "number"
          },
          "currency": {
            "example": "INR",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "currency",
          "balanceMinor",
          "updatedAt"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Demo wallet: users, KYC with document upload, wallet top-ups via payment.",
    "title": "backend_demo wallet API",
    "version": "0.2.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/admin/kyc": {
      "get": {
        "operationId": "Admin_kyc",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "NOT_STARTED",
                "PENDING",
                "APPROVED",
                "REJECTED",
                "TIMED_OUT"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminKycSubmissionPage"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Signed in, but not an admin"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "KYC submissions from every user, newest first",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/kyc/{id}/approve": {
      "post": {
        "operationId": "Admin_approveKyc",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminKycSubmissionResponse"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Signed in, but not an admin"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": ""
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Already approved, still PENDING, or not the latest submission"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Override the provider and approve a REJECTED or TIMED_OUT submission (the user's latest only)",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/kyc/{id}/reject": {
      "post": {
        "operationId": "Admin_rejectKyc",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectKycRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminKycSubmissionResponse"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Signed in, but not an admin"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": ""
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Already rejected, still PENDING, or not the latest submission"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Override the provider and reject an APPROVED or TIMED_OUT submission (the user's latest only)",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/top-ups": {
      "get": {
        "operationId": "Admin_topUps",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "description": "Only this user's top-ups",
            "in": "query",
            "name": "userId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "PENDING",
                "SUCCEEDED",
                "FAILED",
                "TIMED_OUT"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminTopUpPage"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Signed in, but not an admin"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Wallet top-ups from every user (or one), newest first",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/users": {
      "get": {
        "operationId": "Admin_users",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "kycStatus",
            "required": false,
            "schema": {
              "enum": [
                "NOT_STARTED",
                "PENDING",
                "APPROVED",
                "REJECTED",
                "TIMED_OUT"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserPage"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Signed in, but not an admin"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "All users, newest first",
        "tags": [
          "admin"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "Auth_login",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Exchange email and password for an access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
