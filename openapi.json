          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Idempotency-Key reused with a different amount"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Top up the wallet with a payment. Requires approved KYC.",
        "tags": [
          "wallet"
        ]
      }
    }
