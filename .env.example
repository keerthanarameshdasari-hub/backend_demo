# Copy to .env and adjust. Every value here is a dummy for local development.
# The API validates all of these at startup and refuses to start if any are
# missing or invalid. See README.md for what each one does.

NODE_ENV=development
PORT=3000
# error | warn | log | debug | verbose
LOG_LEVEL=log

# Host name "postgres" is the docker-compose service. From your machine use localhost.
DATABASE_URL=postgresql://wallet:wallet@postgres:5432/wallet?schema=public

# At least 32 characters. Generate a real one with: openssl rand -base64 48
JWT_SECRET=replace-me-replace-me-replace-me-replace-me
JWT_ISSUER=backend-demo
JWT_EXPIRES_IN_SECONDS=3600

# Oldest mobile app version still supported (semver), served at /meta/min-app-version
MIN_APP_VERSION=1.0.0
# Origins allowed to call the API from a browser: the admin portal's dev server here.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Adapter selection
STORAGE_PROVIDER=s3
PAYMENT_PROVIDER=mock
KYC_PROVIDER=mock
# Deadline for each payment/KYC provider call; slower answers count as a timeout
PROVIDER_TIMEOUT_MS=3000

# S3 / MinIO. For real AWS: unset S3_ENDPOINT, set S3_FORCE_PATH_STYLE=false and
# leave both keys unset to use the default AWS credential chain (e.g. an IAM role).
S3_BUCKET=kyc-documents
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Money is in minor units (paise for INR): 100 = Rs 1, 10000000 = Rs 1,00,000
WALLET_CURRENCY=INR
TOP_UP_MIN_MINOR=100
TOP_UP_MAX_MINOR=10000000
# 5 MiB
KYC_MAX_DOCUMENT_BYTES=5242880
