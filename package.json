{
  "name": "backend_demo",
  "version": "0.1.0",
  "private": true,
  "description": "Demo wallet API: users, KYC with document upload, wallet top-ups.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --env-file=.env --watch -r ts-node/register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:e2e": "jest test/e2e",
    "openapi": "npm run build && node dist/scripts/generate-openapi.js",
    "openapi:check": "npm run openapi && git diff --exit-code -- openapi.json",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {},
  "devDependencies": {}
}
